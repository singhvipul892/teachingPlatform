# Copy to tests/.env and fill in. tests/.env is gitignored — never commit it.

# The permanent QA account. Create it ONCE by hand (see README.md), leave it as
# role USER, and never buy anything with it. The suite only ever logs in as
# this account; logging in writes nothing to the database.
QA_USER_USERNAME=qa@your-domain.example
QA_USER_PASSWORD=

# The single real environment. Override only to point at a different host.
PROD_BASE_URL=https://teacherplatform.duckdns.org

# The throwaway stack from docker-compose.test.yml. Must stay on loopback:
# a non-loopback value here puts the run in read-only mode, and every
# destructive spec fails rather than writing somewhere real.
TEST_BASE_URL=http://127.0.0.1:18080
